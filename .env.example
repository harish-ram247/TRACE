# Copy to .env and adjust. Never commit .env.

# Database container (docker-compose.yml)
POSTGRES_USER=trace
POSTGRES_PASSWORD=trace
POSTGRES_DB=trace

# App (host port 5433 maps to the container's 5432 to avoid clashing with a local Postgres)
DATABASE_URL=postgresql+asyncpg://trace:trace@localhost:5433/trace
LOG_LEVEL=INFO
RATE_LIMIT_PER_MIN=30

# LLM: any OpenAI-compatible chat completions endpoint. Check your provider's docs for the
# base URL (the part before /chat/completions) and an exact, pinned model name.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Stay under your free tier's limit; responses are cached in data/llm_cache.
LLM_REQUESTS_PER_MINUTE=10

# Optional overrides (defaults in app/core/config.py)
EMBEDDING_MODEL=
NLI_MODEL=
